}
Ref: campus_event_hosts.eventID > campus_events.eventID [update: cascade, delete: cascade]
Ref: campus_event_hosts.teacherID > teachers.teacherID [update: cascade, delete: restrict]
Ref: campus_event_registrations.checkedByAccountID > accounts.accountID [update: cascade, delete: set null]

Table news_categories {
