}
Table campus_event_registrations {
  eventID uuid [not null]
  studentID uuid [not null]
  registeredAt timestamptz [not null, default: `now()`]
  canceledAt timestamptz
  attendedAt timestamptz
  ticketID uuid [not null, unique, default: `gen_random_uuid()`]
  checkedByAccountID uuid
  checkMethod text
  indexes {
    (eventID, studentID) [pk]
  }
}
Ref: campus_events.facultyID > faculties.facultyID [update: cascade, delete: cascade]
Ref: campus_events.buildingID > buildings.buildingID [update: cascade, delete: restrict]
