Ref: sport_weekly_slots.scheduleID > sport_semester_schedules.scheduleID [update: cascade, delete: cascade]
Ref: sport_weekly_slots.classroomID > classroom.classroomID [update: cascade, delete: restrict]
Ref: sport_weekly_slots.teacherID > teachers.teacherID [update: cascade, delete: restrict]
Ref: sport_schedule_occurrences.sportID > sports.sportID [update: cascade, delete: cascade]
Ref: sport_schedule_occurrences.slotID > sport_weekly_slots.slotID [update: cascade, delete: set null]

Table campus_events {
  eventID uuid [pk, default: `gen_random_uuid()`]
  facultyID uuid [not null]
  buildingID uuid [not null]
  createdByEmployerID uuid
  title varchar(128) [not null]
  description varchar(2000) [not null]
  category varchar(16) [not null, note: 'community, career, volunteering']
  startAt timestamptz [not null]
  endAt timestamptz [not null]
  capacity integer [not null]
